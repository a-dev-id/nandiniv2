# Application secrets and machine-specific environment files
.env
.env.*
!.env.example
/auth.json

# Installed dependencies
/node_modules/
/vendor/

# Generated frontend and public runtime files
/public/build/
/public/css/filament/
/public/fonts/filament/
/public/hot
/public/js/filament/
/public/storage
/public/public/storage/
/public_html/storage/

# Laravel runtime data
/bootstrap/cache/*.php
/storage/*.key
/storage/pail/
/storage/debugbar/
/tmp/

# Local databases and database exports containing environment data
/database/*.sqlite
/database/*.sqlite-*
/database/backups/
/database/dumps/
/database/sql/*_backup.sql
/database/sql/*_dump.sql
/database/sql/*_optimized.sql

# Test, coverage, and tool caches
/.cache/
/coverage/
/.phpunit.cache/
.phpunit.result.cache
.phpactor.json
_ide_helper.php

# Local editor and AI-agent settings
/.agents/
/.codex/
/.cursor/
/.fleet/
/.idea/
/.nova/
/.vscode/
/.zed/
*.code-workspace

# Logs, archives, and operating-system files
*.log
*.zip
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# Optional local development environments
Homestead.json
Homestead.yaml
