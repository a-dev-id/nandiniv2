GOOGLE_AFFILIATE_REDIRECT_URI="https://${AFFILIATE_DOMAIN}/login/google/callback"

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ENABLED=true
