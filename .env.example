APP_NAME="Nandini Jungle by Hanging Gardens"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://nandinibali.test
APP_TIMEZONE=Asia/Makassar
MEDIA_URL="${APP_URL}/storage"
MAIN_DOMAIN=nandinibali.test
SPA_DOMAIN=spa.nandinibali.test
SPA_ENABLED=false
MEMBERSHIP_DOMAIN=nandinibali.test
AFFILIATE_DOMAIN=affiliate.nandinibali.test
SHORT_LINK_DOMAIN=go.nandinibali.test
SHORT_LINK_SCHEME=http
TRUSTED_PROXIES=127.0.0.1,::1
AFFILIATE_COUNTRY_HEADER=CF-IPCountry
AFFILIATE_GEOIP_DATABASE=
AFFILIATE_CLICK_HASH_KEY=
AFFILIATE_CLICK_RETENTION_DAYS=395
VOUCHER_DOMAIN=voucher.nandinibali.test
SESSION_DOMAIN=.nandinibali.test
SESSION_SECURE_COOKIE=false
PUBLIC_STORAGE_ROOT=public/storage

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nandiniv2
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FLYWIRE_ENABLED=false
FLYWIRE_INTEGRATION=checkout
# Use production with FLYWIRE_SHARED_SECRET; demo uses FLYWIRE_DEMO_SHARED_SECRET.
FLYWIRE_ENVIRONMENT=demo
FLYWIRE_RECIPIENT_CODE=
FLYWIRE_DEMO_SHARED_SECRET=
FLYWIRE_API_KEY=
FLYWIRE_SHARED_SECRET=
FLYWIRE_RECIPIENT_ID=
FLYWIRE_BILLING_CURRENCY=IDR
FLYWIRE_SANDBOX_PAYER_MIDDLE_NAME=SANDBOX_TO_DELIVERED_STATUS
# Optional demo override. Production always uses Flywire's production API URL.
FLYWIRE_BASE_URL=https://api-platform-sandbox.flywire.com/payments/v1
FLYWIRE_NOTIFICATION_URL=https://voucher.nandinibali.test/api/flywire/notifications
FLYWIRE_RETURN_URL=https://voucher.nandinibali.test/payment/return
FLYWIRE_CANCEL_URL=https://voucher.nandinibali.test/cart
FLYWIRE_ISSUE_ON_STATUSES=guaranteed
VOUCHER_LANDING_PAGE_ID=42
MAIL_GUEST_CC=info@nandinibali.com
AFFILIATE_REGISTRATION_RECIPIENT=reservation@nandinibali.com
AFFILIATE_REGISTRATION_CC=news@nandinibali.com
AFFILIATE_NOTIFICATION_BCC=news@nandinibali.com
MAIL_GUEST_BCC=news@nandinibali.com
MAIL_GUEST_REPLY_TO=reservation@nandinibali.com
VOUCHER_PRINT_CC_EMAILS=reservation@nandinibali.com
VOUCHER_PURCHASE_CC_EMAILS=reservation@nandinibali.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MEMBERSHIP_ENABLED=true
AFFILIATE_ENABLED=true
AFFILIATE_REGISTRATION_ENABLED=true
VOUCHER_ENABLED=true

MEMBERSHIP_API_URL=https://membership.nandiniapps.cloud
MEMBERSHIP_API_TOKEN=
MEMBERSHIP_EMAIL_RELAY_URL=https://membership.nandiniapps.cloud/api/email-relay/send
MEMBERSHIP_EMAIL_RELAY_TOKEN=change-this-to-the-same-secure-token
