APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
PUBLIC_STORAGE_ROOT=../nandinibali.com/storage

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nandiniv2
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_GUEST_BCC=news@nandinibali.com
MAIL_GUEST_REPLY_TO=reservation@nandinibali.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DISABLE_MEMBERSHIP_FEATURE=false

MEMBERSHIP_API_URL=https://membership.nandiniapps.cloud
MEMBERSHIP_API_TOKEN=
MEMBERSHIP_EMAIL_RELAY_URL=https://membership.nandiniapps.cloud/api/email-relay/send
MEMBERSHIP_EMAIL_RELAY_TOKEN=change-this-to-the-same-secure-token
BOOKING_SYNC_CRON_TOKEN=
MEMBERSHIP_LIFECYCLE_CRON_TOKEN=
OFFERS_PUBLICATION_CRON_TOKEN=
WELCOME_EMAIL_TEST_MODE=true
WELCOME_EMAIL_TEST_RECIPIENT=
WELCOME_EMAIL_TEST_TOKEN=
MAIL_TEST_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/membership/sign-in/google/callback"

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ENABLED=true
